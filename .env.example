# ==========================================
# POSTGRESQL: AUTH DATABASE (recipe-auth-db)
# ==========================================
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_secure_password_dev
AUTH_DB_NAME=recipe_auth_db
AUTH_DB_PORT=5432

# ==========================================
# POSTGRESQL: CORE DATABASE (recipe-core-db)
# ==========================================
CORE_DB_USER=core_user
CORE_DB_PASSWORD=core_secure_password_dev
CORE_DB_NAME=recipe_core_db
CORE_DB_PORT=5433

# ==========================================
# MONGODB: SCRAPER CACHE (recipe-scraper-cache)
# ==========================================
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=mongo_secure_password_dev
MONGO_PORT=27017

# ==========================================
# RABBITMQ: MESSAGE BROKER (recipe-message-broker)
# ==========================================
RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=rabbit_secure_password_dev
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672