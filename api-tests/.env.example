# Kopier til .env for å overstyre standardverdiene. Alt er valgfritt.

# local (standard) eller test. Alt annet kjører KUN lesetester (ingen data opprettes, ingen e-post sendes).
# I local må alle URL-ene peke på localhost.
API_TEST_ENV=local

# Alle kall går som standard via gatewayen. Sett AUTH_URL/CORE_URL for å gå rett mot tjenestene
# (nyttig for å avgjøre om en feil ligger i gatewayen eller i tjenesten).
API_TEST_GATEWAY_URL=http://localhost:5000
# API_TEST_AUTH_URL=http://localhost:5001
# API_TEST_CORE_URL=http://localhost:5002

# Admin-kontoen testene logger inn med. Hvis utelatt leses den fra recipe-auth-api sin appsettings
# (AdminUser:Email / AdminUser:Password), som er kontoen IdentitySeeder oppretter i dev.
# API_TEST_ADMIN_EMAIL=
# API_TEST_ADMIN_PASSWORD=

# Nettleser-opprinnelsen CORS-testene bruker (må stå i gatewayens Cors:AllowedOrigins).
# API_TEST_FRONTEND_ORIGIN=http://localhost:3000
# Brukes kun i teksten i e-postsjekklisten.
# API_TEST_MAILPIT_URL=http://localhost:8025
